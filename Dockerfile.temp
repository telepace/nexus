# 临时Dockerfile - 仅用于修复Railway Nixpacks错误
# 这个文件只是为了让Railway停止使用Nixpacks构建
# 实际部署时应该使用各个服务目录下的Dockerfile

FROM nginx:alpine

# 创建一个简单的HTML页面
RUN echo '<html><body><h1>Nexus Project</h1><p>This is a temporary placeholder.</p><p>Please configure individual services in Railway Dashboard.</p></body></html>' > /usr/share/nginx/html/index.html

# 暴露端口
EXPOSE 80

# 启动nginx
CMD ["nginx", "-g", "daemon off;"] 