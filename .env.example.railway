# Railway Environment Variables Template
# Copy this file to set up your Railway environment variables
# Use Railway CLI: railway variables set VARIABLE_NAME=value

# ===========================================
# BASIC CONFIGURATION
# ===========================================

# Domain and Environment
DOMAIN=your-app.railway.app
ENVIRONMENT=production

# Security
SECRET_KEY=your-super-secret-key-here-make-it-long-and-random
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=your-secure-admin-password

# ===========================================
# DATABASE CONFIGURATION (Railway Managed)
# ===========================================

# PostgreSQL - Railway will provide these automatically when you add PostgreSQL service
DATABASE_URL=${{ PostgreSQL.DATABASE_URL }}
POSTGRES_SERVER=${{ PostgreSQL.PGHOST }}
POSTGRES_PORT=${{ PostgreSQL.PGPORT }}
POSTGRES_DB=${{ PostgreSQL.PGDATABASE }}
POSTGRES_USER=${{ PostgreSQL.PGUSER }}
POSTGRES_PASSWORD=${{ PostgreSQL.PGPASSWORD }}

# ===========================================
# REDIS CONFIGURATION (Railway Managed)
# ===========================================

# Redis - Railway will provide these automatically when you add Redis service
REDIS_URL=${{ Redis.REDIS_URL }}
REDIS_HOST=${{ Redis.REDISHOST }}
REDIS_PORT=${{ Redis.REDISPORT }}
REDIS_PASSWORD=${{ Redis.REDISPASSWORD }}
REDIS_DB=0
REDIS_TTL_SECONDS=86400
REDIS_ENABLED=true

# ===========================================
# SERVICE URLs (Auto-configured by Railway)
# ===========================================

# Backend API URL
BACKEND_URL=https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}
PRODUCTION_API_URL=https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}

# Frontend URL
FRONTEND_HOST=https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}
FRONTEND_URL=https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}

# Admin URL
ADMIN_URL=https://${{ admin.RAILWAY_PUBLIC_DOMAIN }}

# Website URL
WEBSITE_URL=https://${{ website.RAILWAY_PUBLIC_DOMAIN }}

# CORS Origins (Dynamic based on deployed services)
BACKEND_CORS_ORIGINS=["https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}", "https://${{ admin.RAILWAY_PUBLIC_DOMAIN }}", "https://${{ website.RAILWAY_PUBLIC_DOMAIN }}"]

# ===========================================
# AI AND LLM CONFIGURATION
# ===========================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (for multiple AI models)
OR_API_KEY=sk-or-v1-your-openrouter-key
OR_SITE_URL=https://openrouter.ai/api/v1
OR_APP_NAME=LiteLLM Nexus App

# LiteLLM Configuration
LITELLM_MASTER_KEY=your-litellm-master-key
LITELLM_PORT=4000
LITELLM_CONFIG_PATH=/app/config.yaml
LITELLM_STORE_MODEL_IN_DB=True

# GitHub Models (if using)
GITHUB_API_KEY=your-github-api-key

# Volcengine (if using)
VOLCENGINE_API_KEY=your-volcengine-key
VOLCENGINE_BASE_URL=https://api.volcengine.com/v1

# ===========================================
# STORAGE CONFIGURATION
# ===========================================

# Supabase (for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=Nexus Platform

# ===========================================
# MONITORING AND ANALYTICS
# ===========================================

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# PostHog for analytics
POSTHOG_KEY=your-posthog-project-key
POSTHOG_HOST=https://app.posthog.com

# Langfuse for LLM observability
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ===========================================
# CONTAINER CONFIGURATION
# ===========================================

# Port configuration (Railway handles this automatically)
BACKEND_CONTAINER_PORT=8000
FRONTEND_CONTAINER_PORT=3000
ADMIN_CONTAINER_PORT=5173
WEBSITE_CONTAINER_PORT=3000

# Worker configuration
WORKERS=4

# ===========================================
# OPTIONAL FEATURES
# ===========================================

# Proxy settings (if needed)
# http_proxy=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080
# all_proxy=socks5://proxy.example.com:1080

# Debug settings (development only)
# DEBUG=true
# LOG_LEVEL=debug

# ===========================================
# RAILWAY DEPLOYMENT NOTES
# ===========================================

# 1. Set these variables using Railway CLI:
#    railway variables set SECRET_KEY=your-secret-key
#    railway variables set FIRST_SUPERUSER=admin@yourdomain.com
#
# 2. Add managed services:
#    railway add postgresql
#    railway add redis
#
# 3. Environment-specific variables can be set with:
#    railway variables set --environment production VARIABLE_NAME=value
#    railway variables set --environment staging VARIABLE_NAME=value
#
# 4. Variables with ${{ service.VARIABLE }} will be automatically 
#    resolved by Railway based on your deployed services
#
# 5. Required variables for deployment:
#    - SECRET_KEY
#    - FIRST_SUPERUSER
#    - FIRST_SUPERUSER_PASSWORD
#    - OPENAI_API_KEY (for AI features)
#
# 6. Optional but recommended:
#    - SENTRY_DSN (error tracking)
#    - SUPABASE_URL and SUPABASE_ANON_KEY (file storage)
#    - SMTP configuration (email features)