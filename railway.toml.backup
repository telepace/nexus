# Railway Root Project Configuration
# This is the main configuration file for the Nexus multi-service project

# Project metadata
[project]
name = "nexus"
description = "Full-stack content management and AI analysis platform"

# Global environment variables for all services
[env.production]
# Domain configuration - Railway will provide these automatically
DOMAIN = "${{ RAILWAY_PUBLIC_DOMAIN }}"
ENVIRONMENT = "production"

# Service URLs - These will be set by Railway based on service deployments
FRONTEND_URL = "https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}"
BACKEND_URL = "https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}"
ADMIN_URL = "https://${{ admin.RAILWAY_PUBLIC_DOMAIN }}"
WEBSITE_URL = "https://${{ website.RAILWAY_PUBLIC_DOMAIN }}"

# Security and secrets
SECRET_KEY = "${{ SECRET_KEY }}"
FIRST_SUPERUSER = "${{ FIRST_SUPERUSER }}"
FIRST_SUPERUSER_PASSWORD = "${{ FIRST_SUPERUSER_PASSWORD }}"

# Email configuration (optional)
SMTP_HOST = "${{ SMTP_HOST }}"
SMTP_USER = "${{ SMTP_USER }}" 
SMTP_PASSWORD = "${{ SMTP_PASSWORD }}"
EMAILS_FROM_EMAIL = "${{ EMAILS_FROM_EMAIL }}"

# External services
SENTRY_DSN = "${{ SENTRY_DSN }}"
POSTHOG_KEY = "${{ POSTHOG_KEY }}"

# AI and LLM configuration
OPENAI_API_KEY = "${{ OPENAI_API_KEY }}"
OPENAI_BASE_URL = "${{ OPENAI_BASE_URL }}"
OR_API_KEY = "${{ OR_API_KEY }}"
LITELLM_MASTER_KEY = "${{ LITELLM_MASTER_KEY }}"

# Storage configuration
SUPABASE_URL = "${{ SUPABASE_URL }}"
SUPABASE_ANON_KEY = "${{ SUPABASE_ANON_KEY }}"

[env.staging]
DOMAIN = "${{ RAILWAY_PUBLIC_DOMAIN }}"
ENVIRONMENT = "staging"

# Service URLs for staging
FRONTEND_URL = "https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}"
BACKEND_URL = "https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}"
ADMIN_URL = "https://${{ admin.RAILWAY_PUBLIC_DOMAIN }}"
WEBSITE_URL = "https://${{ website.RAILWAY_PUBLIC_DOMAIN }}"

# Watch patterns for project-level changes
watchPatterns = [
    "docker-compose.yml",
    "railway.toml",
    ".env.example",
    "specs/**"
]

# Documentation for Railway CLI users:
# 
# IMPORTANT: For Docker Compose projects on Railway:
# 1. Railway does NOT directly support docker-compose.yml deployment
# 2. You need to deploy each service separately as individual Railway services
# 3. Each service should have its own Dockerfile in its respective directory
# 4. Use Railway's service linking for inter-service communication
#
# Recommended deployment approach:
# 1. Create separate Railway services for: backend, frontend, admin
# 2. Add Railway PostgreSQL and Redis services
# 3. Configure environment variables for each service
# 4. Use Railway's internal networking for service communication
#
# Alternative approach - Monolithic deployment:
# Deploy only the backend service and serve frontend as static files
#
# Commands:
# railway login
# railway link [your-project-id]
# railway up --service backend
# railway up --service frontend  
# railway up --service admin